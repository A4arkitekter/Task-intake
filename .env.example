SECRET_KEY=skift-denne-til-en-lang-tilfaeldig-streng

# Indtagelse bruger porte fra 7000 og op for ikke at kollidere med Cursor og andre udviklingsservere.
APP_PORT=7000

# small/cpu/int8 virker overalt. SETUP.bat sætter large-v3 og cuda, når NVIDIA findes.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Peg på en delt cache for at genbruge modeller, du allerede har hentet.
# MODEL_DIR=C:\Users\dig\.cache\huggingface\hub
# Frigiv GPU-hukommelsen efter tomgang, så programmet ikke står i vejen for andet arbejde.
# Koster nogle sekunder på næste idé. 0 slår det fra.
WHISPER_IDLE_UNLOAD_SEC=300

# Wrike API-app (Apps & Integrations → API). Client ID og Secret Key.
WRIKE_CLIENT_ID=
WRIKE_CLIENT_SECRET=
# Permanent Access Token fra samme side (Get token). Mappe, ansvarlig og prioritet vælges i browseren.
WRIKE_TOKEN=

MAIL_CC=ep@a4.dk

LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:14b
# Hvor længe Ollama må holde modellen i GPU-hukommelsen efter brug. "0" frigiver straks.
LLM_KEEP_ALIVE=5m

# Første gæt på mappen telefonen synker til. Brugeren kan rette stien i browseren.
# Android (ASR Voice Recorder): OneDrive\Apps\ASR Cloud Uploads\asr
# iPhone (RecUp): OneDrive eller Dropbox\Apps\RecUp Memos
# INBOX_DIR=C:\Users\dig\OneDrive\Apps\ASR Cloud Uploads\asr
# Behandlede filer flyttes hertil. Hold den uden for den synkroniserede mappe.
# INBOX_ARCHIVE_DIR=
INBOX_POLL_SECONDS=5
INBOX_ARCHIVE=1
NOTIFY=1

# 0 betyder ingen varighedsgrænse på en optagelse.
MAX_DURATION_SEC=0
# Åbn administrationen i browseren, hvis et job fejlede og ingen fane kigger.
AUTO_OPEN=0
AUTO_OPEN_IDLE_SEC=90

# Daglig oversigt over job der ikke kom i Wrike, sendt gennem din kørende Outlook.
# Den gentages hver dag indtil listen er tom.
REMIND_ENABLED=1
# Står den tom, bruges MAIL_CC.
# REMIND_TO=dig@firma.dk
REMIND_AT=08:30
