APP_PASSWORD=skift-mig
SECRET_KEY=skift-denne-til-en-lang-tilfaeldig-streng

# small/cpu/int8 virker overalt. SETUP.bat sætter large-v3 og cuda, når NVIDIA findes.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Peg på en delt cache for at genbruge modeller, du allerede har hentet.
# MODEL_DIR=C:\Users\dig\.cache\huggingface\hub
# Frigiv GPU-hukommelsen efter tomgang, så programmet ikke står i vejen for andet arbejde.
# Koster nogle sekunder på næste idé. 0 slår det fra.
WHISPER_IDLE_UNLOAD_SEC=300

MAIL_TO=wrike@wrike.com
MAIL_CC=ep@a4.dk
MAIL_MARKER=*PODIOWRIKETASKDELETE*

LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:14b
# Hvor længe Ollama må holde modellen i GPU-hukommelsen efter brug. "0" frigiver straks.
LLM_KEEP_ALIVE=5m

# Mappen telefonen synker til. Står den tom, bruges data\indbakke i projektet.
# INBOX_DIR=C:\Users\dig\Dropbox\Apps\ASRRecordings
# Behandlede filer flyttes hertil. Hold den uden for den synkroniserede mappe.
# INBOX_ARCHIVE_DIR=
INBOX_POLL_SECONDS=5
INBOX_ARCHIVE=1
NOTIFY=1

# 0 betyder ingen varighedsgrænse på en optagelse.
MAX_DURATION_SEC=0
# Åbn indbakken i browseren når en idé er klar, men kun hvis ingen fane allerede kigger.
AUTO_OPEN=1
AUTO_OPEN_IDLE_SEC=90

# Daglig oversigt over alt usorteret, sendt gennem din kørende Outlook.
# Den gentages hver dag indtil indbakken er tom, så en gammel idé ikke bliver glemt.
REMIND_ENABLED=1
# Står den tom, bruges MAIL_CC.
# REMIND_TO=dig@firma.dk
REMIND_AT=08:30
